{
  "version": 2,
  "framework": null,
  "buildCommand": "echo 'Static 3D portfolio ready'",
  "outputDirectory": "cloned_site",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/lite-cards",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET, POST, OPTIONS" }
      ]
    }
  ],
  "redirects": [
    { "source": "/about", "destination": "/?glide=about", "permanent": false },
    { "source": "/projects", "destination": "/?glide=projects", "permanent": false },
    { "source": "/contact", "destination": "/?glide=contact", "permanent": false },
    { "source": "/projects/:slug*", "destination": "/lite", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/telemetry/:path*", "destination": "/api/lite-cards" },
    { "source": "/cdn-cgi/:path*", "destination": "/api/lite-cards" },
    { "source": "/api/lite-cards", "destination": "/api/lite-cards" },
    { "source": "/lite/:slug*", "destination": "/lite.html" },
    { "source": "/lite", "destination": "/lite.html" },
    { "source": "/assets/:path*", "destination": "https://assets.aengel.io/:path*" },
    { "source": "/:path((?!_next|assets|custom-enhancements|favicon|icon).*)*", "destination": "https://aengel.io/:path*" }
  ]
}
